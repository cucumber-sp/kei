{
  "entry": ["src/cli.ts", "tests/**/*.test.ts"],
  "project": ["src/**/*.ts", "tests/**/*.ts"],
  "includeEntryExports": true,
  // Bun resolves this declaration through an import attribute on runtime.h.
  "ignore": ["src/runtime/runtime.h.d.ts"],
  // Loaded by Oxlint's type-aware mode, not imported from project sources.
  "ignoreDependencies": ["oxlint-tsgolint"],
}
