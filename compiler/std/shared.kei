// std/shared.kei — Reference-counted shared owner.
//
// One-word handle: the public handle stores only a `ref T` to the
// payload inside one heap allocation `[count: i64 | T payload]`. The
// refcount pointer is derived from the payload address by subtracting
// the count header size.
//
// Mutation is alias-visible and explicit:
//   `s.value = newT`        — write-through (destroy old + oncopy new)
//   `s = Shared<T>.wrap(t)` — handle replacement (full destroy/oncopy)
//
// Copying a Shared<T> bumps the refcount; destroying drops it and frees
// the block when the count reaches zero. v1 is single-threaded — the
// counter is non-atomic. An atomic sibling (`AtomicShared<T>`) is
// planned for v2.

import { alloc, dealloc, placeAt } from mem;

pub unsafe struct Shared<T> {
    value: ref T;

    fn wrap(item: ref T) -> Shared<T> {
        unsafe {
            // ONE allocation: [count: i64 | T payload]
            let block = alloc(sizeof(i64) + sizeof(T));
            let countPtr = block as *i64;
            let valuePtr = ((block as usize) + sizeof(i64)) as *T;

            *countPtr = 1;
            placeAt<T>(valuePtr, item);

            return Shared<T>{ value: valuePtr };
        }
    }

    fn __oncopy(self: ref Shared<T>) {
        unsafe {
            let countPtr = ((self.value as usize) - sizeof(i64)) as *i64;
            *countPtr = *countPtr + 1;
        }
    }

    fn __destroy(self: ref Shared<T>) {
        unsafe {
            let countPtr = ((self.value as usize) - sizeof(i64)) as *i64;
            *countPtr = *countPtr - 1;
            if *countPtr == 0 {
                onDestroy(self.value as *T);
                dealloc(countPtr as *void);
            }
        }
    }
}
